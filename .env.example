# Acá ponemos las variables que usamos en el .env para tener de referencia al momento de subir/clonar el repo
# Los valores son de ejemplo, acá no se ponen los valores de verdad
# La base MySQL se configura en mi-proyecto-strapi/.env.
# La tienda PHP consulta Strapi mediante su API.
# API del catálogo y las cuentas
STRAPI_URL=http://localhost:1337
