{
  "kind": "collectionType",
  "collectionName": "up_users",
  "info": {
    "name": "user",
    "description": "",
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "unique": true,
      "configurable": false,
      "required": true
    },
    "email": {
      "type": "email",
      "minLength": 6,
      "configurable": false,
      "required": true
    },
    "provider": {
      "type": "string",
      "configurable": false
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "resetPasswordToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmationToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.role",
      "inversedBy": "users",
      "configurable": false
    },
    "compras": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::compra.compra",
      "mappedBy": "users_permissions_user"
    },
    "carritos": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::carrito.carrito",
      "mappedBy": "users_permissions_user"
    },
    "Telefono": {
      "type": "string"
    },
    "Provincia": {
      "type": "string"
    },
    "Ciudad": {
      "type": "string"
    },
    "Direccion": {
      "type": "string"
    },
    "Auto_marca": {
      "type": "string"
    },
    "Auto_modelo": {
      "type": "string"
    },
    "Auto_anio": {
      "type": "integer"
    },
    "Frecuencia_compra": {
      "type": "enumeration",
      "enum": [
        "Ocasional",
        "Mensual",
        "Frecuente"
      ]
    },
    "Acepta_descuentos": {
      "type": "boolean"
    },
    "Acepta_promociones": {
      "type": "boolean"
    }
  }
}
