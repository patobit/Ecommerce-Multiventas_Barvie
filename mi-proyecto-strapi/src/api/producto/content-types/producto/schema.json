{
  "kind": "collectionType",
  "collectionName": "productos",
  "info": {
    "singularName": "producto",
    "pluralName": "productos",
    "displayName": "Producto"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Marca": {
      "type": "string"
    },
    "Nombre": {
      "type": "string"
    },
    "Descripcion": {
      "type": "text"
    },
    "Imagen": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Stock": {
      "type": "integer"
    },
    "Precio": {
      "type": "decimal"
    },
    "categoria": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::categoria.categoria",
      "inversedBy": "productos"
    },
    "detalle_compras": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::detalle-compra.detalle-compra",
      "mappedBy": "producto"
    },
    "detalle_carritos": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::detalle-carrito.detalle-carrito",
      "mappedBy": "producto"
    },
    "Precio_oferta": {
      "type": "decimal",
      "min": 0
    }
  }
}
